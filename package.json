{
  "name": "antidote-grammar-checker-integration",
  "version": "2.3.0",
  "description": "Unofficial integration of Antidote, a powerful English and French grammar checker.",
  "repository": "https://github.com/Heziode/obsidian-antidote",
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "dev": "node esbuild.config.mjs --dev",
    "build": "node esbuild.config.mjs",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint --fix",
    "test": "run-s build test:*",
    "test:lint": "eslint",
    "test:prettier": "prettier \"src/**/*.ts\" --list-different",
    "test:spelling": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "release": "auto shipit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@auto-it/conventional-commits": "^11.3.6",
    "@auto-it/omit-commits": "^11.3.6",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "auto": "^11.3.6",
    "bplist-parser": "^0.3.2",
    "conventional-changelog-angular": "^9.4.0",
    "cspell": "^10.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.11.0",
    "i18n-js": "^4.2.2",
    "npm-run-all2": "^9.0.3",
    "obsidian": "^1.13.1",
    "prettier": "^2.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "ws": "^8.21.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prettier": {
    "singleQuote": true
  }
}
